diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index fa3a610..d6823af 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -420,6 +420,37 @@ extern void dbg_init(void);
 
 extern void close_inproc_sync( HANDLE handle );
 
+/* pool of anonymous semaphores, see sync.c */
+#define SEM_POOL_HANDLES 65536
+extern unsigned char sem_pool_state[SEM_POOL_HANDLES];
+extern int sem_pool_close( HANDLE handle );
+extern void sem_pool_announce(void);
+extern NTSTATUS sem_pool_use_slow( HANDLE handle, BOOL foreign );
+
+static inline unsigned int sem_pool_index( HANDLE handle )
+{
+    return (wine_server_obj_handle( handle ) >> 2) - 1;
+}
+
+/* call before using a handle of this process in any way; fails with
+ * STATUS_INVALID_HANDLE for a handle the application closed into the pool */
+static inline NTSTATUS sem_pool_use( HANDLE handle )
+{
+    unsigned int idx = sem_pool_index( handle );
+
+    if (idx >= SEM_POOL_HANDLES || !__atomic_load_n( &sem_pool_state[idx], __ATOMIC_RELAXED )) return STATUS_SUCCESS;
+    return sem_pool_use_slow( handle, FALSE );
+}
+
+/* the same for a handle that may belong to another process */
+static inline void sem_pool_forget( HANDLE handle )
+{
+    unsigned int idx = sem_pool_index( handle );
+
+    if (idx >= SEM_POOL_HANDLES || !__atomic_load_n( &sem_pool_state[idx], __ATOMIC_RELAXED )) return;
+    sem_pool_use_slow( handle, TRUE );
+}
+

+/***********************************************************************
+ * Pool of anonymous semaphores (droiddeck-sempool)
+ *
+ * Some applications (Unity's Mono runtime, for one) create an anonymous
+ * semaphore and close it again thousands of times per second without ever
+ * touching it in between. Each create and each close is a wineserver round
+ * trip. Instead, the handle of a semaphore this process created without a
+ * name, a root directory or a security descriptor is remembered as "fresh";
+ * when such a handle is closed while still fresh, it stays open in the
+ * server and is kept in a small pool, and the next NtCreateSemaphore asking
+ * for the same initial count, maximum and access gets it back. Since nothing
+ * ever looked at or signaled the object, it is indistinguishable from a new
+ * one. Every other operation on a fresh handle (wait, release, query,
+ * duplicate, security, handle flags, ...) makes it an ordinary handle that is
+ * closed normally, and operations on a pooled (closed) handle fail with
+ * STATUS_INVALID_HANDLE as they would after a real close. Handles of other
+ * processes and server requests are untouched; pooled handles die with the
+ * process. WINE_SEM_POOL=0 turns the pool off.
+ *
+ * The state table is read without a lock; it only changes under
+ * fd_cache_mutex, inside an uninterrupted section.
+ */
+#define SEM_POOL_KEYS      8
+#define SEM_POOL_DEPTH     64
+#define SEM_POOL_KEY_MASK  0x0f
+#define SEM_POOL_FRESH     0x10  /* returned by NtCreateSemaphore, not used yet */
+#define SEM_POOL_FREE      0x20  /* closed by the application, kept in the pool */
+
+struct sem_pool_key
+{
+    LONG          initial;
+    LONG          max;
+    ACCESS_MASK   access;
+    unsigned int  count;
+    unsigned int  idx[SEM_POOL_DEPTH];
+};
+
+unsigned char sem_pool_state[SEM_POOL_HANDLES];
+static struct sem_pool_key sem_pool_keys[SEM_POOL_KEYS];
+static unsigned int sem_pool_nb_keys;
+static int sem_pool_enabled = -1;
+static BOOL sem_pool_announced;
+
+static inline HANDLE sem_pool_index_to_handle( unsigned int idx )
+{
+    return wine_server_ptr_handle( (obj_handle_t)(idx + 1) << 2 );
+}
+
+static inline void sem_pool_set_state( unsigned int idx, unsigned char state )
+{
+    __atomic_store_n( &sem_pool_state[idx], state, __ATOMIC_RELAXED );
+}
+
+static BOOL sem_pool_wanted( ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr )
+{
+    int enabled = __atomic_load_n( &sem_pool_enabled, __ATOMIC_RELAXED );
+
+    if (enabled < 0)
+    {
+        const char *env = getenv( "WINE_SEM_POOL" );
+        enabled = !env || atoi( env ) != 0;
+        __atomic_store_n( &sem_pool_enabled, enabled, __ATOMIC_RELAXED );
+    }
+    if (!enabled) return FALSE;
+    if (!attr) return TRUE;
+    return attr->Length == sizeof(*attr) && !attr->ObjectName && !attr->RootDirectory &&
+           !attr->SecurityDescriptor && !(attr->Attributes & ~(OBJ_OPENIF | OBJ_CASE_INSENSITIVE));
+}
+
+/* take a pooled handle matching the parameters; *slot receives the key slot
+ * a newly created handle is tracked with, or -1 */
+static HANDLE sem_pool_get( ACCESS_MASK access, LONG initial, LONG max, int *slot )
+{
+    struct sem_pool_key *key;
+    HANDLE handle = 0;
+    sigset_t sigset;
+    unsigned int i;
+
+    *slot = -1;
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    for (i = 0; i < sem_pool_nb_keys; i++)
+    {
+        key = &sem_pool_keys[i];
+        if (key->initial == initial && key->max == max && key->access == access) break;
+    }
+    if (i == sem_pool_nb_keys && i < SEM_POOL_KEYS)
+    {
+        key = &sem_pool_keys[i];
+        key->initial = initial;
+        key->max = max;
+        key->access = access;
+        key->count = 0;
+        sem_pool_nb_keys++;
+    }
+    if (i < sem_pool_nb_keys)
+    {
+        *slot = i;
+        if (key->count)
+        {
+            unsigned int idx = key->idx[--key->count];
+            sem_pool_set_state( idx, SEM_POOL_FRESH | i );
+            handle = sem_pool_index_to_handle( idx );
+        }
+    }
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    return handle;
+}
+
+/* remember a semaphore handle the server just created as fresh */
+static void sem_pool_track( HANDLE handle, int slot )
+{
+    unsigned int idx = sem_pool_index( handle );
+    sigset_t sigset;
+
+    if (slot < 0 || idx >= SEM_POOL_HANDLES) return;
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    sem_pool_set_state( idx, SEM_POOL_FRESH | slot );
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+}
+
+/* NtClose: caller holds fd_cache_mutex. Returns 1 if the handle went into the
+ * pool (2 the first time, the caller then calls sem_pool_announce() after
+ * leaving the critical section), -1 if it already is in the pool (closed),
+ * 0 to close it normally. */
+int sem_pool_close( HANDLE handle )
+{
+    unsigned int idx = sem_pool_index( handle );
+    struct sem_pool_key *key;
+    unsigned char state;
+
+    if (idx >= SEM_POOL_HANDLES || !(state = sem_pool_state[idx])) return 0;
+    if (state & SEM_POOL_FREE) return -1;
+    key = &sem_pool_keys[state & SEM_POOL_KEY_MASK];
+    if (key->count == SEM_POOL_DEPTH)
+    {
+        sem_pool_set_state( idx, 0 );
+        return 0;
+    }
+    key->idx[key->count++] = idx;
+    sem_pool_set_state( idx, SEM_POOL_FREE | (state & SEM_POOL_KEY_MASK) );
+    if (sem_pool_announced) return 1;
+    /* the caller prints the notice once it has left the critical section */
+    sem_pool_announced = TRUE;
+    return 2;
+}
+
+/* NtClose: the first handle went into the pool; called without fd_cache_mutex */
+void sem_pool_announce(void)
+{
+    fprintf( stderr, "droiddeck-sempool: up and running.\n" );
+}
+
+/* slow path of sem_pool_use(): the handle is fresh or pooled. A fresh handle
+ * becomes an ordinary one. Using a pooled handle fails, unless it may belong
+ * to another process (foreign), in which case it leaves the pool and is
+ * closed for real. */
+NTSTATUS sem_pool_use_slow( HANDLE handle, BOOL foreign )
+{
+    unsigned int i, idx = sem_pool_index( handle );
+    NTSTATUS ret = STATUS_SUCCESS;
+    BOOL evict = FALSE;
+    unsigned char state;
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    state = sem_pool_state[idx];
+    if (state & SEM_POOL_FRESH) sem_pool_set_state( idx, 0 );
+    else if ((state & SEM_POOL_FREE) && !foreign) ret = STATUS_INVALID_HANDLE;
+    else if (state & SEM_POOL_FREE)
+    {
+        struct sem_pool_key *key = &sem_pool_keys[state & SEM_POOL_KEY_MASK];
+
+        for (i = 0; i < key->count; i++)
+        {
+            if (key->idx[i] != idx) continue;
+            key->idx[i] = key->idx[--key->count];
+            break;
+        }
+        sem_pool_set_state( idx, 0 );
+        evict = TRUE;
+    }
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+
+    if (evict) NtClose( sem_pool_index_to_handle( idx ) );
+    return ret;
+}
+
